# ============================================
# 天宫 (Tiangong) 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# --- 数据库 ---
# Zeabur MySQL 连接串
# 格式: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@host:port/database

# --- 认证 ---
# JWT 密钥（生成随机字符串: openssl rand -hex 32）
APP_SECRET=your-app-secret-here

# --- 管理员账号（必填，无默认值，未设置将拒绝启动）---
# 请勿在此处或任何提交到 git 的文件中填写真实凭据
ADMIN_USER=your-admin-username
ADMIN_PASSWORD=your-admin-password-here

# --- 部署 ---
NODE_ENV=production
PORT=3000

# --- GitHub App (P11, 可选) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_WEBHOOK_SECRET=

# --- New API 只读管理接入（可选）---
# New API 网关地址；客户端默认读取 /api/models、/api/channels 等只读管理路径
NEWAPI_BASE_URL=https://your-newapi-gateway.example.com
# Secret Vault 中保存 New API 管理 token 的引用名；不要在此处填写明文 token
NEWAPI_ADMIN_TOKEN_REF=secret:newapi:tiangong-readonly-admin
# New API 管理接口请求超时（毫秒）
NEWAPI_TIMEOUT_MS=15000

# --- New API 网关接入（OpenCode runner 执行模型调用）---
# runner-opencode.mjs 通过这些变量把 opencode 的模型调用指向 New API 网关
# （OpenAI 兼容），并解析 opencode run --format json 事件流上报真实 token 用量。
# 真实密钥放在 git-ignored 的 scripts/openclaw-connector/.env.local，不要提交。
# NEW_API_BASE_URL=https://your-newapi-gateway.example.com
# NEW_API_API_KEY=sk-xxx
# NEW_API_MODEL=deepseek-v4-flash

# --- Xuanji memory connector (optional) ---
# Base URL for the Xuanji tRPC connector API.
XUANJI_BASE_URL=
# Secret reference or connector token value used as the Bearer credential.
XUANJI_API_KEY_REF=
# Request timeout in milliseconds.
XUANJI_TIMEOUT_MS=30000
